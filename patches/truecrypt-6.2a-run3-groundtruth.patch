+	GT_EVT_FORMAT_BACKUP_BEGIN     = 64,
+	GT_EVT_MASTER_KEYDATA_REUSED   = 65,
+	GT_EVT_WRITE_BACKUP_HEADER     = 66,
+
+	GT_EVT_RESERVED_PRIMARY_KEY1   = 67,
+	GT_EVT_RESERVED_PRIMARY_KEY2   = 68,
+	GT_EVT_RESERVED_PRIMARY_PLAIN  = 69,
+	GT_EVT_WRITE_PRIMARY_RESERVED  = 70,
+
+	GT_EVT_RESERVED_BACKUP_KEY1    = 71,
+	GT_EVT_RESERVED_BACKUP_KEY2    = 72,
+	GT_EVT_RESERVED_BACKUP_PLAIN   = 73,
+	GT_EVT_WRITE_BACKUP_RESERVED   = 74,
+
+	GT_EVT_FORMAT_END              = 75
+};
