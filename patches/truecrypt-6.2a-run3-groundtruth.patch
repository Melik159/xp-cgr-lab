diff --git a/software/truecrypt-archive/gt-6.2a-run3/build-gt/gt_create.c b/software/truecrypt-archive/gt-6.2a-run3/build-gt/gt_create.c
new file mode 100644
index 0000000..e95d876
--- /dev/null
+++ b/software/truecrypt-archive/gt-6.2a-run3/build-gt/gt_create.c
@@ -0,0 +1,197 @@
+#include <windows.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "Common/Tcdefs.h"
+#include "Common/Password.h"
+#include "Common/Crypto.h"
+#include "Common/Random.h"
+#include "Common/Volumes.h"
+#include "Common/GroundTruth.h"
+
+static int write_binary (const char *path, const void *buf, size_t len)
+{
+	FILE *f;
+
+	f = fopen (path, "wb");
+	if (f == NULL)
+		return 0;
+
+	if (fwrite (buf, 1, len, f) != len)
+	{
+		fclose (f);
+		return 0;
+	}
+
+	fclose (f);
+	return 1;
+}
+
+int main (int argc, char **argv)
+{
+	static const char defaultPassword[] = "GT-TrueCrypt-6.2a-2009!";
+
+	const char *passwordText;
+	size_t passwordLength;
+
+	Password password;
+	unsigned char header[TC_VOLUME_HEADER_EFFECTIVE_SIZE];
+
+	PCRYPTO_INFO cryptoInfo = NULL;
+	PCRYPTO_INFO verifyInfo = NULL;
+
+	unsigned __int64 volumeSize;
+	unsigned __int64 dataOffset;
+	unsigned __int64 dataAreaSize;
+
+	int rc;
+
+	passwordText = argc >= 2 ? argv[1] : defaultPassword;
+	passwordLength = strlen (passwordText);
+
+	memset (&password, 0, sizeof (password));
+
+	if (passwordLength > sizeof (password.Text))
+	{
+		fprintf (stderr, "Password too long: %lu bytes\n",
+			(unsigned long) passwordLength);
+		return 2;
+	}
+
+	password.Length = (int) passwordLength;
+	memcpy (password.Text, passwordText, passwordLength);
+
+	/*
+	 * Controlled 16 MiB normal file-container geometry.
+	 *
+	 * This reproduces the non-hidden-volume geometry used by Format.c:
+	 *
+	 *   dataOffset   = TC_VOLUME_DATA_OFFSET
+	 *   dataAreaSize = volumeSize - TC_TOTAL_VOLUME_HEADERS_SIZE
+	 */
+	volumeSize = 16ULL * 1024ULL * 1024ULL;
+	dataOffset = TC_VOLUME_DATA_OFFSET;
+	dataAreaSize = volumeSize - TC_TOTAL_VOLUME_HEADERS_SIZE;
+
+	printf ("TrueCrypt 6.2a GT header generator\n");
+	printf ("volumeSize   = %I64u\n", volumeSize);
+	printf ("dataOffset   = %I64u\n", dataOffset);
+	printf ("dataAreaSize = %I64u\n", dataAreaSize);
+	printf ("EA            = AES\n");
+	printf ("mode          = FIRST_MODE_OF_OPERATION_ID\n");
+	printf ("PRF           = RIPEMD160\n");
+
+	/*
+	 * Initialise the genuine TrueCrypt 6.2a random subsystem.
+	 * CGR calls made below will therefore occur on the OS running this EXE.
+	 */
+	rc = Randinit ();
+	if (rc != 0)
+	{
+		fprintf (stderr, "Randinit failed: %d\n", rc);
+		return 3;
+	}
+
+	/*
+	 * Explicit controlled choice for this experiment.
+	 * Do not interpret this as a claim about the UI default.
+	 */
+	RandSetHashFunction (RIPEMD160);
+
+	memset (header, 0, sizeof (header));
+
+	rc = CreateVolumeHeaderInMemory (
+		FALSE,                         /* non-boot volume */
+		(char *) header,
+		AES,
+		FIRST_MODE_OF_OPERATION_ID,    /* XTS in 6.2a */
+		&password,
+		RIPEMD160,
+		NULL,                          /* generate new master key material */
+		&cryptoInfo,
+		dataAreaSize,
+		0,                             /* normal, not hidden */
+		dataOffset,
+		dataAreaSize,
+		0,                             /* use normal minimum required version */
+		0,                             /* normal volume flags */
+		FALSE                          /* not wipe mode */
+	);
+
+	if (rc != 0)
+	{
+		fprintf (stderr,
+			"CreateVolumeHeaderInMemory failed: %d\n",
+			rc);
+
+		RandStop (TRUE);
+		GTFlush ();
+		return 4;
+	}
+
+	if (!write_binary (
+		"gt-primary-header.bin",
+		header,
+		sizeof (header)))
+	{
+		fprintf (stderr, "Cannot write gt-primary-header.bin\n");
+
+		if (cryptoInfo != NULL)
+			crypto_close (cryptoInfo);
+
+		RandStop (TRUE);
+		GTFlush ();
+		return 5;
+	}
+
+	/*
+	 * Independent validation using TrueCrypt's own header reader.
+	 * GT tracing is already disarmed after header encryption, so this
+	 * verification does not contaminate the creation trace.
+	 */
+	rc = ReadVolumeHeader (
+		FALSE,
+		(char *) header,
+		&password,
+		&verifyInfo,
+		NULL
+	);
+
+	printf ("CreateVolumeHeaderInMemory = PASS\n");
+	printf ("ReadVolumeHeader rc        = %d\n", rc);
+
+	if (rc != 0)
+	{
+		fprintf (stderr, "Header self-verification FAILED\n");
+
+		if (verifyInfo != NULL)
+			crypto_close (verifyInfo);
+
+		if (cryptoInfo != NULL)
+			crypto_close (cryptoInfo);
+
+		RandStop (TRUE);
+		GTFlush ();
+		return 6;
+	}
+
+	printf ("Header self-verification  = PASS\n");
+
+	if (verifyInfo != NULL)
+		crypto_close (verifyInfo);
+
+	if (cryptoInfo != NULL)
+		crypto_close (cryptoInfo);
+
+	RandStop (TRUE);
+
+	/*
+	 * Only now perform disk I/O for the GT trace.
+	 */
+	GTFlush ();
+
+	printf ("GT trace                  = truecrypt-gt.bin\n");
+	printf ("Primary header             = gt-primary-header.bin\n");
+
+	return 0;
+}
