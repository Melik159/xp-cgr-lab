diff --git a/software/truecrypt-archive/gt-6.2a-run3/Common/GroundTruth.c b/software/truecrypt-archive/gt-6.2a-run3/Common/GroundTruth.c
new file mode 100644
index 0000000..97b8b9b
--- /dev/null
+++ b/software/truecrypt-archive/gt-6.2a-run3/Common/GroundTruth.c
@@ -0,0 +1,215 @@
+#include <windows.h>
+#include <string.h>
+#include <stdlib.h>
+#include "GroundTruth.h"
+
+#pragma pack(push, 1)
+typedef struct
+{
+	char magic[4];
+	DWORD version;
+	DWORD headerSize;
+
+	DWORD event;
+	DWORD phase;
+	DWORD sequence;
+
+	DWORD pid;
+	DWORD tid;
+
+	DWORD qpcLow;
+	DWORD qpcHigh;
+
+	DWORD dataLen;
+	DWORD aux0;
+	DWORD aux1;
+} GT_RECORD;
+#pragma pack(pop)
+
+#define GT_BUFFER_CAPACITY (64UL * 1024UL * 1024UL)
+
+static CRITICAL_SECTION gtLock;
+static BOOL gtReady = FALSE;
+static BOOL gtFlushed = FALSE;
+static BOOL gtOverflow = FALSE;
+
+static volatile LONG gtPhase = GT_PHASE_NONE;
+static DWORD gtSequence = 0;
+
+static BYTE *gtBuffer = NULL;
+static DWORD gtUsed = 0;
+
+static char gtPath[MAX_PATH] = "truecrypt-gt.bin";
+
+void GTFlush (void);
+
+void GTInit (void)
+{
+	DWORD n;
+
+	if (gtReady)
+		return;
+
+	InitializeCriticalSection (&gtLock);
+
+	n = GetEnvironmentVariableA ("TC_GT_LOG", gtPath, sizeof (gtPath));
+	if (n >= sizeof (gtPath))
+		strcpy (gtPath, "truecrypt-gt.bin");
+
+	gtBuffer = (BYTE *) VirtualAlloc (
+		NULL,
+		GT_BUFFER_CAPACITY,
+		MEM_COMMIT | MEM_RESERVE,
+		PAGE_READWRITE);
+
+	gtReady = TRUE;
+
+	if (gtBuffer != NULL)
+	{
+		atexit (GTFlush);
+		GTLog (GT_EVT_INIT, NULL, 0, 0, 0);
+	}
+}
+
+static volatile LONG gtRngLifecycle = 0;
+
+void GTSetRngLifecycle (BOOL enabled)
+{
+	InterlockedExchange (&gtRngLifecycle, enabled ? 1 : 0);
+}
+
+BOOL GTGetRngLifecycle (void)
+{
+	return InterlockedCompareExchange (&gtRngLifecycle, 0, 0) != 0;
+}
+
+static BOOL GTIsRngEvent (DWORD event)
+{
+	return event == GT_EVT_RANDADD_INT32
+		|| event == GT_EVT_RANDADD_BUF
+		|| event == GT_EVT_RANDMIX_PRE
+		|| event == GT_EVT_RANDMIX_POST
+		|| (event >= GT_EVT_RANDGET_BEGIN && event <= GT_EVT_RANDGET_POOL_POST)
+		|| (event >= GT_EVT_CGR_SLOW_OUT && event <= GT_EVT_CGR_FAST_POOL_POST);
+}
+
+void GTSetPhase (DWORD phase)
+{
+	InterlockedExchange (&gtPhase, (LONG) phase);
+}
+
+DWORD GTGetPhase (void)
+{
+	return (DWORD) gtPhase;
+}
+
+void GTLog (
+	DWORD event,
+	const void *data,
+	DWORD dataLen,
+	DWORD aux0,
+	DWORD aux1)
+{
+	GT_RECORD r;
+	LARGE_INTEGER qpc;
+	DWORD required;
+
+	if (!gtReady || gtBuffer == NULL)
+		return;
+
+	/*
+	 * RUN3 keeps the existing semantic phase gate, but permits RNG events
+	 * during the explicit TCFormatVolume lifecycle window. This captures
+	 * interstitial Randget/FastPoll activity without globally arming all
+	 * semantic events.
+	 */
+	if (event != GT_EVT_INIT && GTGetPhase () == GT_PHASE_NONE)
+	{
+		if (!GTGetRngLifecycle () || !GTIsRngEvent (event))
+			return;
+	}
+
+	required = sizeof (GT_RECORD) + dataLen;
+
+	EnterCriticalSection (&gtLock);
+
+	if (required > GT_BUFFER_CAPACITY - gtUsed)
+	{
+		gtOverflow = TRUE;
+		LeaveCriticalSection (&gtLock);
+		return;
+	}
+
+	memset (&r, 0, sizeof (r));
+
+	r.magic[0] = 'T';
+	r.magic[1] = 'C';
+	r.magic[2] = 'G';
+	r.magic[3] = 'T';
+
+	r.version = 1;
+	r.headerSize = sizeof (r);
+
+	r.event = event;
+	r.phase = GTGetPhase ();
+	r.sequence = ++gtSequence;
+
+	r.pid = GetCurrentProcessId ();
+	r.tid = GetCurrentThreadId ();
+
+	QueryPerformanceCounter (&qpc);
+	r.qpcLow = qpc.LowPart;
+	r.qpcHigh = qpc.HighPart;
+
+	r.dataLen = dataLen;
+	r.aux0 = aux0;
+	r.aux1 = aux1;
+
+	memcpy (gtBuffer + gtUsed, &r, sizeof (r));
+	gtUsed += sizeof (r);
+
+	if (data != NULL && dataLen != 0)
+	{
+		memcpy (gtBuffer + gtUsed, data, dataLen);
+		gtUsed += dataLen;
+	}
+
+	LeaveCriticalSection (&gtLock);
+}
+
+void GTFlush (void)
+{
+	HANDLE h;
+	DWORD written;
+	DWORD marker[2];
+
+	if (!gtReady || gtFlushed || gtBuffer == NULL)
+		return;
+
+	gtFlushed = TRUE;
+
+	h = CreateFileA (
+		gtPath,
+		GENERIC_WRITE,
+		FILE_SHARE_READ,
+		NULL,
+		CREATE_ALWAYS,
+		FILE_ATTRIBUTE_NORMAL,
+		NULL);
+
+	if (h == INVALID_HANDLE_VALUE)
+		return;
+
+	WriteFile (h, gtBuffer, gtUsed, &written, NULL);
+
+	/*
+	 * Eight-byte trailer outside the record stream:
+	 * 0x47544F56 = "GTOV", second DWORD = overflow flag.
+	 */
+	marker[0] = 0x47544F56;
+	marker[1] = gtOverflow ? 1 : 0;
+
+	WriteFile (h, marker, sizeof (marker), &written, NULL);
+	FlushFileBuffers (h);
+	CloseHandle (h);
+}
diff --git a/software/truecrypt-archive/gt-6.2a-run3/Common/GroundTruth.c.file-logger b/software/truecrypt-archive/gt-6.2a-run3/Common/GroundTruth.c.file-logger
new file mode 100644
index 0000000..3074bce
--- /dev/null
+++ b/software/truecrypt-archive/gt-6.2a-run3/Common/GroundTruth.c.file-logger
@@ -0,0 +1,139 @@
+#include <windows.h>
+#include <string.h>
+#include "GroundTruth.h"
+
+#pragma pack(push, 1)
+typedef struct
+{
+	char magic[4];
+	DWORD version;
+	DWORD headerSize;
+
+	DWORD event;
+	DWORD phase;
+	DWORD sequence;
+
+	DWORD pid;
+	DWORD tid;
+
+	DWORD qpcLow;
+	DWORD qpcHigh;
+
+	DWORD dataLen;
+	DWORD aux0;
+	DWORD aux1;
+} GT_RECORD;
+#pragma pack(pop)
+
+static HANDLE gtFile = INVALID_HANDLE_VALUE;
+static CRITICAL_SECTION gtLock;
+static BOOL gtReady = FALSE;
+static volatile LONG gtPhase = GT_PHASE_NONE;
+static DWORD gtSequence = 0;
+
+void GTInit (void)
+{
+	char path[MAX_PATH];
+	DWORD n;
+
+	if (gtReady)
+		return;
+
+	InitializeCriticalSection (&gtLock);
+
+	n = GetEnvironmentVariableA ("TC_GT_LOG", path, sizeof (path));
+
+	if (n == 0 || n >= sizeof (path))
+		strcpy (path, "truecrypt-gt.bin");
+
+	gtFile = CreateFileA (
+		path,
+		GENERIC_WRITE,
+		FILE_SHARE_READ,
+		NULL,
+		CREATE_ALWAYS,
+		FILE_ATTRIBUTE_NORMAL,
+		NULL);
+
+	gtReady = TRUE;
+
+	GTLog (GT_EVT_INIT, NULL, 0, 0, 0);
+}
+
+void GTSetPhase (DWORD phase)
+{
+	InterlockedExchange (&gtPhase, (LONG) phase);
+}
+
+DWORD GTGetPhase (void)
+{
+	return (DWORD) gtPhase;
+}
+
+void GTLog (
+	DWORD event,
+	const void *data,
+	DWORD dataLen,
+	DWORD aux0,
+	DWORD aux1)
+{
+	GT_RECORD r;
+	LARGE_INTEGER qpc;
+	DWORD written;
+
+	if (!gtReady || gtFile == INVALID_HANDLE_VALUE)
+		return;
+
+	EnterCriticalSection (&gtLock);
+
+	memset (&r, 0, sizeof (r));
+
+	r.magic[0] = 'T';
+	r.magic[1] = 'C';
+	r.magic[2] = 'G';
+	r.magic[3] = 'T';
+
+	r.version = 1;
+	r.headerSize = sizeof (r);
+
+	r.event = event;
+	r.phase = GTGetPhase ();
+	r.sequence = ++gtSequence;
+
+	r.pid = GetCurrentProcessId ();
+	r.tid = GetCurrentThreadId ();
+
+	QueryPerformanceCounter (&qpc);
+
+	r.qpcLow  = qpc.LowPart;
+	r.qpcHigh = qpc.HighPart;
+
+	r.dataLen = dataLen;
+	r.aux0 = aux0;
+	r.aux1 = aux1;
+
+	WriteFile (
+		gtFile,
+		&r,
+		sizeof (r),
+		&written,
+		NULL);
+
+	if (data != NULL && dataLen != 0)
+	{
+		WriteFile (
+			gtFile,
+			data,
+			dataLen,
+			&written,
+			NULL);
+	}
+
+	LeaveCriticalSection (&gtLock);
+}
+
+void GTFlush (void)
+{
+	if (gtReady && gtFile != INVALID_HANDLE_VALUE)
+		FlushFileBuffers (gtFile);
+}
