@@ -0,0 +1,19 @@
+TrueCrypt 6.2a Ground-Truth RUN3 transport v2
+
+Purpose:
+  File-hosted, non-hidden, 16 MiB, AES, RIPEMD-160, FAT, quick format.
+
+Executable SHA-256:
+  7a09763386b62179a617dcc880da9b9a5fedb6451f2b84fc73afab0d6d60947c  gt_format_quick.exe
+
+Instrumentation correction:
+  Direct physical-write events are armed only for the event itself and
+  immediately disarmed afterwards.
+
+RUN3_PREP.BAT copies the executable to C:\GT_RUN3 and does not execute it.
+RUN3_EXEC.BAT is one-shot and refuses to overwrite existing RUN3 outputs.
+
+Expected outputs:
+  C:\GT_RUN3\truecrypt-gt.bin
+  C:\GT_RUN3\gt-run3-fat-quick.tc
+  C:\GT_RUN3\run3.exit.txt
diff --git a/software/truecrypt-archive/gt-6.2a-run3/build-gt/run3-transport/readback/RUN3_EXEC.BAT b/software/truecrypt-archive/gt-6.2a-run3/build-gt/run3-transport/readback/RUN3_EXEC.BAT
new file mode 100644
index 0000000..2ff02e1
--- /dev/null
+++ b/software/truecrypt-archive/gt-6.2a-run3/build-gt/run3-transport/readback/RUN3_EXEC.BAT
@@ -0,0 +1,24 @@
+@echo off
+cd /d C:\GT_RUN3
+
+if exist truecrypt-gt.bin goto EXISTS
+if exist gt-run3-fat-quick.tc goto EXISTS
+if exist run3.exit.txt goto EXISTS
+
+echo RUN3 one-shot execution starting...
+gt_format_quick.exe gt-run3-fat-quick.tc
+echo %ERRORLEVEL%>run3.exit.txt
+
+echo.
+echo RUN3 finished.
+echo Preserve C:\GT_RUN3 before any rerun.
+pause
+goto END
+
+:EXISTS
+echo.
+echo REFUSE: prior RUN3 output already exists in C:\GT_RUN3
+echo This batch will not overwrite or rerun it.
+pause
+
+:END
diff --git a/software/truecrypt-archive/gt-6.2a-run3/build-gt/run3-transport/readback/RUN3_PREP.BAT b/software/truecrypt-archive/gt-6.2a-run3/build-gt/run3-transport/readback/RUN3_PREP.BAT
