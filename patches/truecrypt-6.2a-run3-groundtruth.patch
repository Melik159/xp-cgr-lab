diff --git a/software/truecrypt-archive/gt-6.2a-run3/Common/Random.c.gt-original b/software/truecrypt-archive/gt-6.2a-run3/Common/Random.c.gt-original
new file mode 100644
index 0000000..fd973ce
--- /dev/null
+++ b/software/truecrypt-archive/gt-6.2a-run3/Common/Random.c.gt-original
@@ -0,0 +1,783 @@
+/*
