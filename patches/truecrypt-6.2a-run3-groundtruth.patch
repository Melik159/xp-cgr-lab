diff --git a/software/truecrypt-archive/gt-6.2a-run3/build-gt/gt_format_quick.c b/software/truecrypt-archive/gt-6.2a-run3/build-gt/gt_format_quick.c
new file mode 100644
index 0000000..180c469
--- /dev/null
+++ b/software/truecrypt-archive/gt-6.2a-run3/build-gt/gt_format_quick.c
@@ -0,0 +1,105 @@
+#include <windows.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "Common/Tcdefs.h"
+#include "Common/Password.h"
+#include "Common/Crypto.h"
+#include "Common/Random.h"
+#include "Common/Volumes.h"
+#include "Common/Format.h"
+#include "Common/GroundTruth.h"
+
+int main (int argc, char **argv)
+{
+	static const char defaultPassword[] =
+		"GT-TrueCrypt-6.2a-RUN3-2009!";
+
+	const char *containerPath =
+		(argc >= 2) ? argv[1] : "gt-run3-fat-quick.tc";
+
+	const char *passwordText =
+		(argc >= 3) ? argv[2] : defaultPassword;
+
+	size_t passwordLength;
+
+	Password password;
+	FORMAT_VOL_PARAMETERS vol;
+
+	int realClusterSize = 0;
+	int rc;
+
+	passwordLength = strlen (passwordText);
+
+	if (passwordLength > sizeof (password.Text))
+	{
+		fprintf (stderr, "Password too long\n");
+		return 2;
+	}
+
+	memset (&password, 0, sizeof (password));
+	password.Length = (int) passwordLength;
+	memcpy (password.Text, passwordText, passwordLength);
+
+	memset (&vol, 0, sizeof (vol));
+
+	vol.bDevice          = FALSE;
+	vol.hiddenVol        = FALSE;
+	vol.volumePath       = (char *) containerPath;
+	vol.size             = 16ULL * 1024ULL * 1024ULL;
+	vol.hiddenVolHostSize = 0;
+
+	vol.ea               = AES;
+	vol.pkcs5            = RIPEMD160;
+	vol.headerFlags      = 0;
+
+	vol.fileSystem       = FILESYS_FAT;
+	vol.clusterSize      = 0;       /* TrueCrypt default */
+	vol.sparseFileSwitch = FALSE;
+	vol.quickFormat      = TRUE;
+
+	vol.realClusterSize  = &realClusterSize;
+	vol.password         = &password;
+	vol.hwndDlg          = NULL;
+
+	printf ("TrueCrypt 6.2a GT RUN3 physical formatter\n");
+	printf ("container     = %s\n", containerPath);
+	printf ("size          = %I64u\n", vol.size);
+	printf ("filesystem    = FAT\n");
+	printf ("quickFormat   = TRUE\n");
+	printf ("EA            = AES\n");
+	printf ("PRF           = RIPEMD160\n");
+
+	rc = Randinit ();
+	if (rc != 0)
+	{
+		fprintf (stderr, "Randinit failed: %d\n", rc);
+		return 3;
+	}
+
+	RandSetHashFunction (RIPEMD160);
+
+	GTSetRngLifecycle (TRUE);
+	rc = TCFormatVolume (&vol);
+	GTSetRngLifecycle (FALSE);
+
+	if (rc != 0)
+	{
+		fprintf (stderr, "TCFormatVolume failed: %d\n", rc);
+
+		RandStop (TRUE);
+		GTFlush ();
+		return 4;
+	}
+
+	printf ("TCFormatVolume = PASS\n");
+	printf ("realClusterSize = %d\n", realClusterSize);
+
+	RandStop (TRUE);
+	GTFlush ();
+
+	printf ("GT trace       = truecrypt-gt.bin\n");
+	printf ("container      = %s\n", containerPath);
+
+	return 0;
+}
