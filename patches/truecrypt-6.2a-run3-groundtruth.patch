diff --git a/software/truecrypt-archive/gt-6.2a-run3/build-gt/run2-transport-v2/README.TXT b/software/truecrypt-archive/gt-6.2a-run3/build-gt/run2-transport-v2/README.TXT
new file mode 100644
index 0000000..c3ab3f9
--- /dev/null
+++ b/software/truecrypt-archive/gt-6.2a-run3/build-gt/run2-transport-v2/README.TXT
@@ -0,0 +1,19 @@
+TrueCrypt 6.2a Ground-Truth RUN2 transport v2
+
+Purpose:
+  File-hosted, non-hidden, 16 MiB, AES, RIPEMD-160, FAT, quick format.
+
+Executable SHA-256:
+  c4ac46b17c5980226c1a777babbc5f659fc863aa4c2e7c966e02a62fa5b0f20d  gt_format_quick.exe
+
+Instrumentation correction:
+  Direct physical-write events are armed only for the event itself and
+  immediately disarmed afterwards.
+
+RUN2_PREP.BAT copies the executable to C:\GT_RUN2 and does not execute it.
+RUN2_EXEC.BAT is one-shot and refuses to overwrite existing RUN2 outputs.
+
+Expected outputs:
+  C:\GT_RUN2\truecrypt-gt.bin
+  C:\GT_RUN2\gt-run2-fat-quick.tc
+  C:\GT_RUN2\run2.exit.txt
diff --git a/software/truecrypt-archive/gt-6.2a-run3/build-gt/run2-transport-v2/RUN2_EXEC.BAT b/software/truecrypt-archive/gt-6.2a-run3/build-gt/run2-transport-v2/RUN2_EXEC.BAT
new file mode 100644
index 0000000..34cbc7f
--- /dev/null
+++ b/software/truecrypt-archive/gt-6.2a-run3/build-gt/run2-transport-v2/RUN2_EXEC.BAT
@@ -0,0 +1,24 @@
+@echo off
+cd /d C:\GT_RUN2
+
+if exist truecrypt-gt.bin goto EXISTS
+if exist gt-run2-fat-quick.tc goto EXISTS
+if exist run2.exit.txt goto EXISTS
+
+echo RUN2 one-shot execution starting...
+gt_format_quick.exe gt-run2-fat-quick.tc
+echo %ERRORLEVEL%>run2.exit.txt
+
+echo.
+echo RUN2 finished.
+echo Preserve C:\GT_RUN2 before any rerun.
+pause
+goto END
+
+:EXISTS
+echo.
+echo REFUSE: prior RUN2 output already exists in C:\GT_RUN2
+echo This batch will not overwrite or rerun it.
+pause
+
+:END
diff --git a/software/truecrypt-archive/gt-6.2a-run3/build-gt/run2-transport-v2/RUN2_PREP.BAT b/software/truecrypt-archive/gt-6.2a-run3/build-gt/run2-transport-v2/RUN2_PREP.BAT
new file mode 100644
index 0000000..7f363df
--- /dev/null
+++ b/software/truecrypt-archive/gt-6.2a-run3/build-gt/run2-transport-v2/RUN2_PREP.BAT
@@ -0,0 +1,8 @@
+@echo off
+if not exist C:\GT_RUN2 mkdir C:\GT_RUN2
+copy /Y "%~dp0gt_format_quick.exe" C:\GT_RUN2\gt_format_quick.exe
+copy /Y "%~dp0SHA256SUMS.TXT" C:\GT_RUN2\SHA256SUMS.TXT
+echo.
+echo RUN2 prepared in C:\GT_RUN2
+echo Nothing has been executed.
+pause
diff --git a/software/truecrypt-archive/gt-6.2a-run3/build-gt/run2-transport-v2/SHA256SUMS.TXT b/software/truecrypt-archive/gt-6.2a-run3/build-gt/run2-transport-v2/SHA256SUMS.TXT
