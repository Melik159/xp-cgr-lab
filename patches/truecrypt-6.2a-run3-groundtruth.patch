+++ b/software/truecrypt-archive/gt-6.2a-run3/build-gt/run3-transport/readback/RUN3_PREP.BAT
@@ -0,0 +1,8 @@
+@echo off
+if not exist C:\GT_RUN3 mkdir C:\GT_RUN3
+copy /Y "%~dp0gt_format_quick.exe" C:\GT_RUN3\gt_format_quick.exe
+copy /Y "%~dp0SHA256SUMS.TXT" C:\GT_RUN3\SHA256SUMS.TXT
+echo.
+echo RUN3 prepared in C:\GT_RUN3
+echo Nothing has been executed.
+pause
