+	GT_EVT_MASTER_KEYDATA          = 53,
+	GT_EVT_SALT                    = 54,
+	GT_EVT_PBKDF2_DK               = 55,
+	GT_EVT_HEADER_PLAIN            = 56,
+	GT_EVT_HEADER_KEY_PRIMARY      = 57,
+	GT_EVT_HEADER_KEY_SECONDARY    = 58,
+	GT_EVT_HEADER_CIPHER           = 59,
+
+	GT_EVT_FORMAT_PRIMARY_BEGIN    = 60,
+	GT_EVT_WRITE_PRIMARY_HEADER    = 61,
+	GT_EVT_WRITE_PRIMARY_ZERO      = 62,
