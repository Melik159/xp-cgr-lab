@@ -0,0 +1,24 @@
+@echo off
+cd /d C:\GT_RUN3
+
+if exist truecrypt-gt.bin goto EXISTS
+if exist gt-run3-fat-quick.tc goto EXISTS
+if exist run3.exit.txt goto EXISTS
+
+echo RUN3 one-shot execution starting...
+gt_format_quick.exe gt-run3-fat-quick.tc
+echo %ERRORLEVEL%>run3.exit.txt
+
+echo.
+echo RUN3 finished.
+echo Preserve C:\GT_RUN3 before any rerun.
+pause
+goto END
+
+:EXISTS
+echo.
+echo REFUSE: prior RUN3 output already exists in C:\GT_RUN3
+echo This batch will not overwrite or rerun it.
+pause
+
+:END
